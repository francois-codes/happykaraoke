{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": ["vite.config.ts", "src/server/**/*", "src/shared/**/*"],
  "compilerOptions": {
    "outDir": "out/server",
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": [
        "src/shared/*"
      ],
      "@/*": [
        "src/server/*"
      ]}
  }
}
