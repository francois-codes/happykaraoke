{
  "name": "happikaraoke",
  "version": "2.10.0",
  "description": "Reboot of the happikaraoke app",
  "main": "out/server/main.js",
  "author": "Francois Roland <francois.roland@gmail.com>",
  "scripts": {
    "dev": "NODE_ENV=development tsx esbuild.dev.config.ts",
    "build:client": "vite build",
    "build:server": "tsx esbuild.config.ts",
    "build:electron": "electron-builder build --config electron-builder.yml",
    "prebuild": "npm run clean && cp assets/CHEATSHEET.md README.TXT && npm run install:deps:electron",
    "build": "npm run build:client && npm run build:server && npm run build:electron",
    "typecheck:client": "tsc -p tsconfig.web.json --noEmit",
    "typecheck:server": "tsc -p tsconfig.node.json --noEmit",
    "typecheck": "npm run typecheck:client && npm run typecheck:server",
    "clean": "rimraf out",
    "install:deps:electron": "electron-rebuild -f -w better-sqlite3 && cd node_modules/better-sqlite3 && npx node-gyp rebuild --debug --build-from-source --runtime=electron --target=30.1.0 --dist-url=https://electronjs.org/headers",
    "install:deps:web": "cd node_modules/better-sqlite3 && npx node-gyp rebuild --debug --build-from-source --runtime=node --target=24.11.0",
    "db:migration:generate": "npm exec drizzle-kit generate --out migrations --schema ./src/shared/db/schema.ts",
    "db:migration:run": "npm exec drizzle-kit push",
    "db:seed": "tsx ./src/shared/db/seed.ts",
    "test:invariants": "jest tests/invariants/ || vitest tests/invariants/",
    "demo:sync": "npm start -- --demo-sync"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:francois-codes/happi-karaoke-2.git"
  },
  "keywords": [],
  "license": "ISC",
  "dependencies": {
    "@ai-sdk/openai": "^2.0.57",
    "@ai-sdk/perplexity": "^2.0.15",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/utils": "^3.0.0",
    "@hookform/resolvers": "^3.6.0",
    "@radix-ui/react-alert-dialog": "^1.0.5",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-navigation-menu": "^1.1.4",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "ai": "^5.0.82",
    "axios": "^1.7.2",
    "better-sqlite3": "^9.6.0",
    "body-parser": "^1.20.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "date-fns": "^3.6.0",
    "drizzle-orm": "^0.31.2",
    "express": "^4.19.2",
    "ip": "^2.0.1",
    "lucide-react": "^0.383.0",
    "memfs": "^4.9.3",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.51.5",
    "react-icons": "^5.2.1",
    "react-qr-code": "^2.0.14",
    "react-router-dom": "^6.23.1",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "sqlite3": "^5.1.7",
    "tailwind-merge": "^2.3.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^10.0.0",
    "vite-express": "^0.17.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^2.0.0",
    "@electron-toolkit/eslint-config-ts": "^1.0.1",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron/rebuild": "^3.6.0",
    "@types/better-sqlite3": "^7.6.10",
    "@types/express": "^4.17.21",
    "@types/ip": "^1.1.3",
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "bindings": "^1.5.0",
    "drizzle-kit": "^0.22.7",
    "electron": "^30.1.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.21.5",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "postcss": "^8.4.38",
    "prettier": "^3.2.4",
    "rimraf": "^5.0.7",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.15.4",
    "typescript": "^5.4.5",
    "vite": "^5.3.0",
    "vite-plugin-node-polyfills": "^0.22.0"
  }
}
